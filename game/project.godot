; Godot-Projektdatei. Am besten im Editor ändern (Projekt > Projekteinstellungen).

config_version=5

[application]

config/name="Spiegelrealitäten (Arbeitstitel)"
config/description="Third-Person-Action-RPG in den Spiegelrealitäten der Konzerne."
run/main_scene="res://scenes/levels/test_arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://scripts/systems/event_bus.gd"
GameState="*res://scripts/systems/game_state.gd"
SaveSystem="*res://scripts/systems/save_system.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87),
Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83),
Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65),
Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68),
Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
