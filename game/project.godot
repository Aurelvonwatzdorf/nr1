[layer_names]

3d_physics/layer_1="Welt"
3d_physics/layer_2="Spieler"
3d_physics/layer_3="Gegner"
3d_physics/layer_4="Hitbox"
3d_physics/layer_5="Hurtbox"
3d_physics/layer_6="Interaktion"
3d_physics/layer_7="NPC"

[physics]

common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
