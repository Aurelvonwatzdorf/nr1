[sub_resource type="Resource" id="Resource_hswaa"]
script = ExtResource("1_e38e3")
id = &"narbe"
region_name = "Die Narbe"
epoch = "Verwüstete Zukunft"
description = "Ein ausgebeutetes Land voller Krater und Bohrtürme der Konzerne."
style = 1
center = Vector2(20, -560)
radius = 220.0
base_height = 6.0
relief = 6.0
ground_color = Color(0.45, 0.32, 0.24, 1)
accent_color = Color(0.6, 0.35, 0.2, 1)
road_color = Color(0.3, 0.27, 0.25, 1)
plant_count = 90
npc_count = 2
npc_names = PackedStringArray("Schrottsammlerin", "Schrottsammler")
npc_lines = Array[String](["Die Bohrtürme saugen alles aus dem Boden. Das Wasser hier ist rot.", "Früher war hier ein Wald. Dann kamen die Konzerne mit ihren Maschinen.", "Geh nicht zu nah an den Krater. Wer runterfällt, kommt anders wieder hoch."])
npc_colors = Array[Color]([Color(0.45, 0.4, 0.35, 1), Color(0.55, 0.35, 0.25, 1)])
fog_color = Color(0.75, 0.5, 0.35, 1)
fog_density = 0.0016

[sub_resource type="Resource" id="Resource_inoop"]
script = ExtResource("1_e38e3")
id = &"kagero"
region_name = "Kagerō-Gebirge"
epoch = "Zeit der Schreine"
description = "Hohe Berge mit roten Ahornwäldern, Schreinen und dem versiegelten Bergtempel."
style = 2
center = Vector2(560, -520)
radius = 340.0
base_height = 22.0
relief = 120.0
relief_frequency = 0.0035
ground_color = Color(0.42, 0.45, 0.32, 1)
accent_color = Color(0.8, 0.3, 0.2, 1)
road_color = Color(0.5, 0.42, 0.32, 1)
plant_count = 520
npc_names = PackedStringArray("Pilgerin", "Pilger", "Mönch")
npc_lines = Array[String](["Der Weg zum Bergtempel ist steil. Viele kehren auf halber Höhe um.", "Unter jedem Torbogen bleibt man kurz stehen. So zeigt man den Bergen Respekt.", "Das Tor des Bergtempels ist seit Jahren versiegelt. Man sagt, es öffnet sich nur für ein Ritual.", "Im Herbst werden die Ahornwälder rot wie Glut."])
npc_colors = Array[Color]([Color(0.75, 0.7, 0.6, 1), Color(0.3, 0.35, 0.45, 1), Color(0.6, 0.25, 0.2, 1)])
fog_color = Color(0.7, 0.74, 0.8, 1)
fog_density = 0.0005

[sub_resource type="Resource" id="Resource_pnv3k"]
script = ExtResource("1_e38e3")
id = &"steppe"
region_name = "Die Ewige Steppe"
epoch = "Zeit der Reiterclans"
description = "Weites Grasland unter einem riesigen Himmel. Jurtenlager und Steinhügel mit blauen Tüchern."
center = Vector2(-560, -480)
radius = 380.0
base_height = 6.0
ground_color = Color(0.6, 0.6, 0.32, 1)
accent_color = Color(0.75, 0.7, 0.4, 1)
road_color = Color(0.55, 0.48, 0.35, 1)
plant_count = 160
npc_count = 4
npc_names = PackedStringArray("Hirtin", "Hirte", "Reiterin")
npc_lines = Array[String](["Wer an einem Steinhügel vorbeikommt, legt einen Stein dazu und geht dreimal herum.", "Unsere Jurten ziehen mit den Herden. Nächsten Monat stehen wir am Fluss.", "Hier ist der Himmel größer als irgendwo sonst. Die Stadt sieht von hier aus klein aus.", "Komm rein und trink Tee mit uns. Ein Gast bringt Glück ins Lager."])
npc_colors = Array[Color]([Color(0.7, 0.25, 0.2, 1), Color(0.25, 0.4, 0.65, 1), Color(0.8, 0.65, 0.3, 1)])
fog_color = Color(0.85, 0.85, 0.75, 1)
fog_density = 0.0003

[sub_resource type="Resource" id="Resource_27xgm"]
script = ExtResource("1_e38e3")
id = &"grauwald"
region_name = "Grauwald-Mark"
epoch = "Mittelalter"
description = "Bewaldete Hügel, eine Burg, ein Fachwerkdorf mit Windmühle und Kapelle."
style = 4
center = Vector2(-640, 160)
radius = 320.0
base_height = 6.0
relief = 24.0
relief_frequency = 0.006
ground_color = Color(0.3, 0.45, 0.26, 1)
accent_color = Color(0.45, 0.55, 0.3, 1)
road_color = Color(0.45, 0.38, 0.28, 1)
plant_count = 420
npc_count = 4
npc_names = PackedStringArray("Bäuerin", "Bauer", "Schmied", "Wache der Burg")
npc_lines = Array[String](["Die Burg auf dem Hügel schützt uns, solange wir unsere Abgaben zahlen.", "Die Mühle dreht sich Tag und Nacht. Ohne sie gäbe es kein Brot.", "In der Kapelle läutet die Glocke zur Abendandacht. Jeder ist willkommen.", "Leute aus der Stadt mit leuchtenden Augen? Die sehen wir hier nicht gern."])
npc_colors = Array[Color]([Color(0.45, 0.35, 0.25, 1), Color(0.3, 0.4, 0.3, 1), Color(0.55, 0.2, 0.2, 1)])
fog_color = Color(0.7, 0.75, 0.7, 1)
fog_density = 0.0009

[sub_resource type="Resource" id="Resource_2qxng"]
script = ExtResource("1_e38e3")
id = &"nebelwald"
region_name = "Nebelwald"
epoch = "Zeitlos"
description = "Riesige leuchtende Bäume und dichter Nebel. Ein Ort, an dem die Geisterwelt nah ist."
style = 5
center = Vector2(-380, 620)
radius = 280.0
base_height = 5.0
relief = 14.0
relief_frequency = 0.006
ground_color = Color(0.18, 0.3, 0.32, 1)
accent_color = Color(0.4, 0.9, 0.85, 1)
road_color = Color(0.3, 0.35, 0.35, 1)
plant_count = 260
npc_count = 2
npc_names = PackedStringArray("Einsiedlerin", "Einsiedler")
npc_lines = Array[String](["Hör genau hin. Die Bäume flüstern, wenn jemand Neues kommt.", "Im Herzen des Waldes ist die Luft so schwer, dass man kaum atmen kann. Nur wer innerlich stark ist, kommt durch.", "Hier vergeht die Zeit anders. Ich bin seit gestern hier, sagen die anderen. Mir kommt es wie Jahre vor."])
npc_colors = Array[Color]([Color(0.3, 0.4, 0.45, 1), Color(0.5, 0.55, 0.5, 1)])
fog_color = Color(0.55, 0.85, 0.8, 1)
fog_density = 0.006

[sub_resource type="Resource" id="Resource_ftmpp"]
script = ExtResource("1_e38e3")
id = &"kemet"
region_name = "Sonnenreich Kemet"
epoch = "Altes Ägypten"
description = "Goldene Wüste, ein grüner Fluss, Pyramiden, Obelisken und ein Säulentempel."
style = 6
center = Vector2(220, 660)
radius = 340.0
relief = 6.0
ground_color = Color(0.85, 0.72, 0.45, 1)
accent_color = Color(0.95, 0.8, 0.5, 1)
road_color = Color(0.7, 0.6, 0.42, 1)
plant_count = 120
npc_count = 4
npc_names = PackedStringArray("Schreiberin", "Bauer am Fluss", "Steinmetz", "Händlerin")
npc_lines = Array[String](["Der Fluss ist unser Leben. Wo sein Wasser hinkommt, wächst alles.", "An den Pyramiden wird seit Generationen gebaut. Jeder Stein wurde von Hand gesetzt.", "Der Wächterlöwe sieht nach Osten, zur aufgehenden Sonne.", "Ich schreibe auf, was die Leute ernten. Ohne Schrift würde jeder alles vergessen."])
npc_colors = Array[Color]([Color(0.92, 0.9, 0.82, 1), Color(0.25, 0.45, 0.6, 1), Color(0.8, 0.6, 0.25, 1)])
fog_color = Color(0.95, 0.85, 0.65, 1)
fog_density = 0.0004

[sub_resource type="Resource" id="Resource_r2wfa"]
script = ExtResource("1_e38e3")
id = &"neu_vallis"
region_name = "Neu-Vallis"
epoch = "Gegenwart"
description = "Eine ganz normale Vorstadt wie aus der Gegenwart: Häuser, Tankstelle, Funkmast, Stadion."
style = 7
center = Vector2(650, 160)
radius = 280.0
relief = 3.0
ground_color = Color(0.4, 0.55, 0.32, 1)
accent_color = Color(0.6, 0.6, 0.6, 1)
road_color = Color(0.22, 0.22, 0.24, 1)
plant_count = 140
npc_count = 4
npc_names = PackedStringArray("Pendlerin", "Tankwart", "Schüler", "Rentnerin")
npc_lines = Array[String](["Hier ist die Zeit einfach stehen geblieben. Kein Neon, keine Implantate. Mir gefällt das.", "Samstags ist Spiel im Stadion. Dann ist die ganze Stadt auf den Beinen.", "Mein Handy findet nie Empfang. Der Funkmast sendet nur Rauschen.", "Die Leute aus Santo Santiago kaufen hier alte Sachen. Sie nennen es Nostalgie."])
npc_colors = Array[Color]([Color(0.3, 0.35, 0.55, 1), Color(0.6, 0.3, 0.3, 1), Color(0.4, 0.4, 0.42, 1)])
fog_color = Color(0.8, 0.85, 0.9, 1)
fog_density = 0.0004

[sub_resource type="Resource" id="Resource_u4rae"]
script = ExtResource("1_e38e3")
id = &"glaskueste"
region_name = "Die Gläserne Küste"
epoch = "Ferne Zukunft"
description = "Weiße Türme, Glaskuppeln und eine schwebende Bahn. Der Sitz der Konzerne von morgen."
style = 8
center = Vector2(800, -180)
radius = 200.0
relief = 3.0
ground_color = Color(0.75, 0.8, 0.82, 1)
accent_color = Color(0.45, 0.85, 1, 1)
road_color = Color(0.88, 0.9, 0.92, 1)
plant_count = 80
npc_count = 2
npc_names = PackedStringArray("Konzernforscherin", "Wartungsdrohne")
npc_lines = Array[String](["Willkommen an der Küste der Zukunft. Bitte berühren Sie nichts.", "Was hier gebaut wird, sieht Santo Santiago erst in hundert Jahren.", "Die Bahn fährt ohne Schienen. Niemand weiß genau, wie."])
npc_colors = Array[Color]([Color(0.9, 0.92, 0.95, 1), Color(0.3, 0.6, 0.8, 1)])
fog_color = Color(0.85, 0.92, 1, 1)
fog_density = 0.0004

