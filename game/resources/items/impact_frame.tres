[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/items/item_data.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"impact_frame"
display_name = "Aufschlag (Implantat)"
description = "Cyborg-Implantat vom Schwarzmarkt: verstärkte Knie und ein Dämpferkern in der Wirbelsäule. In der Luft (ab 3 m Höhe) schwerer Angriff: senkrecht herabstürzen und mit einer Druckwelle aufschlagen. Bis 15 m kein eigener Fallschaden."
kind = 1
color = Color(0.75, 0.9, 1, 1)
grants_ground_slam = true
