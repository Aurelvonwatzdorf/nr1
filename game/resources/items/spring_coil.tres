[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/items/item_data.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"spring_coil"
display_name = "Sprungfeder (Implantat)"
description = "Cyborg-Implantat vom Schwarzmarkt: gespannte Federn in den Unterschenkeln. Leertaste am Boden halten lädt einen hohen Sprung auf (bis zur doppelten Höhe), loslassen springt. Kurz getippt: normaler Sprung. Verträgt sich mit den Cyberbeinen (Doppelsprung)."
kind = 1
color = Color(0.7, 0.8, 0.4, 1)
grants_charge_jump = true
