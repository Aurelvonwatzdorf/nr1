[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/items/item_data.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"shadow_skin"
display_name = "Schattenhaut (Implantat)"
description = "Cyborg-Implantat vom Schwarzmarkt: eine Haut aus lichtbrechenden Schuppen. G (Gamepad: Steuerkreuz hoch halten): 5 Sekunden fast unsichtbar, 20 Fokus. Angreifen beendet die Tarnung, der erste Treffer daraus ist härter. Konzernwachen sehen einen erst ganz nah; Spiegeljäger sehen hindurch."
kind = 1
color = Color(0.3, 0.35, 0.5, 1)
grants_camouflage = true
