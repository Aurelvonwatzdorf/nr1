[node name="CaptureCell" type="Node3D"]
script = ExtResource("1_cell")
reality_id = &"capture_cell"
reality_name = "Das Wartezimmer"
clues_needed = 2
exit_scene = "res://scenes/levels/santo_santiago.tscn"
anchoring_per_second = 0.5
intro_lines = Array[String](["Wo bist du? … Ein Wartezimmer. Du wartest. Worauf eigentlich?", "Sie haben dich eingesperrt. Drück Q. Irgendwo hat diese Welt eine Naht."])
intro_lines_tahirou = Array[String](["Twin, wach auf. Das ist kein Wartezimmer. Das ist ein Käfig.", "Drück Q. Die Raben können dich hier nicht hören, aber ich schon."])
returns_to_capture_point = true
wake_message = "Du bist entkommen. Die Spiegeljäger haben dich verloren."

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_main")

