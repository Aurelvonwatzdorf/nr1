[node name="NPCs" type="Node3D" parent="."]

[node name="Colleague" parent="NPCs" instance=ExtResource("10_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -8.7, 0, 4)
script = ExtResource("11_talker")
lines = Array[String](["Morgen, Aurel. Die Quartalszahlen liegen schon auf deinem Tisch. Wie jeden Morgen.", "Hast du auch das Gefühl, dass die Uhr nie weiterläuft? … Ach, vergiss es."])
lines_tahirou = Array[String](["Du bist der neue Kurier, oder? Leg das Paket einfach … wo ist dein Paket?", "Seltsam. Ich könnte schwören, du standest gestern schon genauso da."])
npc_id = &"tower_colleague"
display_name = "Kollegin"
body_color = Color(0.55, 0.55, 0.62, 1)

[node name="Coworker" parent="NPCs" instance=ExtResource("10_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 8.3, 0, -4)
script = ExtResource("11_talker")
lines = Array[String](["Wenn du die Beförderung willst, musst du länger bleiben als alle anderen.", "Die Wachen? Die sind zu unserer Sicherheit da. Frag nicht weiter."])
lines_tahirou = Array[String](["Entspann dich. Hier kommt sowieso keiner raus. Ich meine … vor Feierabend.", "Die Wachen mögen keine Fremden. Halt den Kopf unten."])
npc_id = &"tower_coworker"
display_name = "Kollege"
body_color = Color(0.4, 0.45, 0.55, 1)

[node name="Manager" parent="NPCs" instance=ExtResource("10_npc")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -12)
script = ExtResource("11_talker")
lines = Array[String](["Aurel. Ich hoffe, Sie wissen, wem Sie Ihren Platz hier verdanken.", "Niemand verlässt das Stockwerk vor Feierabend. Und Feierabend ist, wann ich es sage."])
lines_tahirou = Array[String](["Lieferungen nur über den Hintereingang. Wer hat Sie überhaupt hereingelassen?", "Bleiben Sie, wo Sie sind. Die Sicherheit kümmert sich um Sie."])
npc_id = &"tower_manager"
display_name = "Abteilungsleiterin"
body_color = Color(0.3, 0.3, 0.35, 1)

[node name="Adam" parent="NPCs" instance=ExtResource("10_npc")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 4, 0, -84)
