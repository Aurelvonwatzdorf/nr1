[node name="CorporateTower" type="Node3D"]
script = ExtResource("1_tower")
reality_id = &"corporate_tower"
reality_name = "Der Konzernturm"
exit_scene = "res://scenes/levels/santo_santiago.tscn"
intro_lines = Array[String](["Guten Morgen, Aurel. Noch ein Tag im Turm. Warum fühlt er sich an, als hättest du ihn schon tausendmal erlebt?", "Sieh genauer hin. Wenn dir etwas falsch vorkommt, drück Q."])
intro_lines_tahirou = Array[String](["Twin. Du solltest hier nur ein Paket abgeben. Wie lange stehst du schon in diesem Büro?", "Etwas stimmt nicht. Drück Q und sieh hinter die Fassade."])
wake_message = "Du wachst auf, mitten in Santo Santiago. Der Turm war nie echt."

