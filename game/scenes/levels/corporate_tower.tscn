[node name="ClueDesk" parent="Clues" instance=ExtResource("7_clue")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.5, 0, 5)
companion_line = "Derselbe Kaffeefleck wie gestern. Und vorgestern. Und am Tag davor."

[node name="ClueGallery" parent="Clues" instance=ExtResource("7_clue")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 16, 3, -35)
companion_line = "Akten über dich. Jeden Tag dieselbe Unterschrift. Deine Hand hat sie nie geschrieben."

[node name="ClueArchive" parent="Clues" instance=ExtResource("7_clue")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -16, 0, -75)
companion_line = "Hinter der Wand ist nichts. Kein Raum, kein Licht. Nur das, was sie dich glauben lassen."

[node name="Rift" parent="." instance=ExtResource("8_rift")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -86)

[node name="AnchorMirror" parent="." instance=ExtResource("4_mirror")]
